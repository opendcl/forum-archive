(DEFUN cnterr (CadenaError)
(SETQ *error* error0)
(IF (= CadenaError "Function cancelled")
    (progn
        (dcl_Form_Close estbk_Formulario1)
(PROMPT "La función ha sido interrumpida por el usuario."))
)
(TERPRI)
(PRIN1)
) 



(defun f:namtag()

    (SETQ error0 *error* *error* cnterr)
    
    (setq blox (ssget '((66 . 1))))

                (if (= blox nil)
                (progn
                  (alert "No selecciono bloques con atributos!")
                  (dcl_Form_show estbk_Formulario1)
                  (exit)
                  )
         )
    
    (setq n 0)
    (setq listtag nil)
    (repeat (sslength blox)
        (setq entins (ssname blox n))
        (setq entblk (entget entins))
        (setq namblk (cdr (assoc 2 entblk)))
        (setq perono (member namblk listtag))
        (if (= perono nil)
            (setq listtag (cons namblk listtag))
            )
        (setq n (+ 1 n))
        )
(if (/= blox nil)
    (dcl_ComboBox_AddList estbk_Formulario1_CuadroCombinado1 listtag)
    )
    )

(defun f:selfilt ()
    (SETQ error0 *error* *error* cnterr)
       
       (setq bloxfl (ssget "P" (list (cons 2 bksel3))))
       (setq bloxf2 (sslength bloxfl))(setq nq 0)

(repeat 1
        (setq entins1 (ssname bloxfl nq))
        (setq entatt1 entins1)
        (setq lstattsins nil)
        (setq tittag nil)
        (while
            (= (cdr (assoc 0
                           (setq lent (entget (setq entatt1 (entnext entatt1))))
                    )
               )
               "ATTRIB"
            )  ;; comprobar el primer attributo del bloque si tiene data attrib
               (setq tag (cdr (assoc 2 lent)))
               ;;extrae el nombre del ATTRIB
               (setq val (cdr (assoc 1 lent)))
               ;;extrae el valor de ATTRIB
               (setq lstattsins (cons (list tag val) lstattsins))
               ;;formar lista con el nombre y el valor de atributo
               (setq tittag (cons tag tittag))
            )    
    )
)
    
