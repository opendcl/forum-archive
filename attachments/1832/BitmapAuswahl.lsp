;********************************************************************************************
(defun p:BitmapWahlDialog (kv-paare / Result Y)
  (setq x:bitmapwahl_kv_pairs (list)
	x:bitmapwahl_selected 0)
  (cond ((and (> (length kv-paare) 1)
	      x:opendcl_ist_aktiviert
	      (p:dcl_Project_Load "BitmapAuswahl")
	      )
	 
	 (foreach x kv-paare
	   (if (setq y (findfile (car x)))
	     (setq x:bitmapwahl_kv_pairs (cons (cons y (cdr x))
					       x:bitmapwahl_kv_pairs)))
	   )
	 (if (setq x:bitmapwahl_kv_pairs (reverse x:bitmapwahl_kv_pairs))
	   (setq Result (dcl_Form_Show BitmapAuswahl_BitmapBrowser))
	   )
	 (cond  ((= Result 1)
		 (setq Result (cadr(nth x:bitmapwahl_selected x:bitmapwahl_kv_pairs)))
		 )
		('T
		 (setq Result 'nil)
		 ))
	 )
	((equal (length kv-paare) 1)
	 (setq Result (cadr(car kv-paare)))
	 )
	('T
	 (setq Result 'nil)
	 ))
  (setq x:bitmapwahl_kv_pairs 'nil
	x:bitmapwahl_selected 'nil)
  Result
)
