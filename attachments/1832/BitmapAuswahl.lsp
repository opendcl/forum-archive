(defun c:BitmapAuswahl_BitmapBrowser_OnInitialize (/)
  (p:dcl_Form_Center BitmapAuswahl_BitmapBrowser)
  (dcl_Control_SetMinValue BitmapAuswahl_BitmapBrowser_sliderBitmapBrowse 0)
  (dcl_Control_SetMaxValue BitmapAuswahl_BitmapBrowser_sliderBitmapBrowse (1- (length x:bitmapwahl_kv_pairs)))
  (dcl_Control_SetLargeChange BitmapAuswahl_BitmapBrowser_sliderBitmapBrowse 1)
  (dcl_Control_SetSmallChange BitmapAuswahl_BitmapBrowser_sliderBitmapBrowse 1)
  (if (not (eval (cons 'OR (mapcar 'caddr x:bitmapwahl_kv_pairs))))
    (dcl_Control_SetEnabled BitmapAuswahl_BitmapBrowser_btnHelp 'nil)
    (dcl_Control_SetEnabled BitmapAuswahl_BitmapBrowser_btnHelp 'T)
    )
  (p:BitmapAuswahl_BitmapBrowser_update)
)
