    (if
        (or (equal datcolm (list "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" ""))
            (equal datcolm (list "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" "" ""))
            )
        (dcl_MessageBox "Los Campos de la columna Bloques no fueron definidos" "" 2)
        (f:reemplz)
